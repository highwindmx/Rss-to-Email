# RSS 源地址，多个用逗号分隔；支持两种写法：纯 url，或 标题|url（标题会显示在邮件每条前缀的【】里）
RSS_URLS=示例源|https://example.com/feed.xml,https://another.com/rss

# 轮询间隔（分钟）：脚本自节流，未到间隔则跳过本次运行，可自由调整
# 仅当 SCHEDULE_MODE=interval 时生效
POLL_INTERVAL_MINUTES=30

# 触发方式：interval（默认，固定间隔轮询）/ fixed_times（每日多时点强制抓取）
SCHEDULE_MODE=interval
# 多时点模式的定时时刻（逗号分隔 HH:MM，24 小时制）；仅 SCHEDULE_MODE=fixed_times 生效
SCHEDULE_TIMES=08:00,12:00,20:00

# 发件邮箱 SMTP 配置（用授权码，不是登录密码）
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SENDER_EMAIL=your_send@163.com
SMTP_AUTH_CODE=your_smtp_auth_code

# 目标邮箱，多个用逗号分隔
RECIPIENTS=your_inbox@126.com

# 检查最近 N 小时内的条目（旧条目直接标记为已处理，避免积压）
CHECK_HOURS=24
