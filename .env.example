# RSS 源地址，多个用逗号分隔
# 格式：标题|url （标题可空；留空则邮件里回退用频道自身标题）
RSS_URLS=示例源|https://example.com/feed.xml

# 轮询间隔（分钟）：APScheduler 每分钟 tick，未到间隔则自节流跳过
POLL_INTERVAL_MINUTES=30

# 发件邮箱 SMTP 配置（用授权码，不是登录密码）
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SENDER_EMAIL=your_email@163.com
SMTP_AUTH_CODE=your_auth_code

# 目标邮箱，多个用逗号分隔
RECIPIENTS=recipient@example.com

# 检查最近 N 小时内的条目（更早的条目直接标为已处理，避免积压）
CHECK_HOURS=24
